{
  "name": "@commercetools-labs/shopper-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Shopper journey analytics for ecommerce sites — one script tag, a Postgres collector, and a reporting admin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "start": "npm run start -w @commercetools-labs/shopper-analytics-server",
    "dev": "npm run dev -w @commercetools-labs/shopper-analytics-server",
    "dev:collect": "npm run dev:collect -w @commercetools-labs/shopper-analytics-server",
    "dev:admin": "npm run dev:admin -w @commercetools-labs/shopper-analytics-server",
    "dev:storefront": "npm start -w @commercetools-labs/shopper-analytics-example-storefront",
    "migrate": "npm run migrate -w @commercetools-labs/shopper-analytics-server",
    "seed": "npm run seed -w @commercetools-labs/shopper-analytics-server",
    "retention": "npm run retention -w @commercetools-labs/shopper-analytics-server",
    "site:add": "node scripts/add-site.js",
    "db:create": "node scripts/create-db.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "predeploy": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
